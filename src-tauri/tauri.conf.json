{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horsey Mod Manager",
  "version": "0.1.1",
  "identifier": "com.chris.horseymodmanager",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Horsey Mod Manager",
        "width": 620,
        "height": 480,
        "minWidth": 460,
        "minHeight": 320,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
